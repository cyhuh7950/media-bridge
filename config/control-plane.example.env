# Non-secret Control Plane settings. Do not put provider, database, password,
# credential, pepper, or signing-key values in this file.
MEDIA_BRIDGE_CONTROL_DATABASE_URL_FILE=/run/secrets/media_bridge_database_url
MEDIA_BRIDGE_CONTROL_SECURITY_PEPPER_FILE=/run/secrets/media_bridge_security_pepper
MEDIA_BRIDGE_SNAPSHOT_PRIVATE_KEY_FILE=/run/secrets/media_bridge_snapshot_ed25519_key
MEDIA_BRIDGE_SNAPSHOT_KEY_ID=media-bridge-snapshot-key-01
MEDIA_BRIDGE_SNAPSHOT_PATH=/var/lib/media-bridge/config/active-snapshot.json
MEDIA_BRIDGE_CONTROL_ORIGIN=https://media-bridge.example.com
MEDIA_BRIDGE_CONTROL_HOST=media-bridge.example.com
MEDIA_BRIDGE_CONTROL_BIND_HOST=127.0.0.1
MEDIA_BRIDGE_CONTROL_PORT=8081
