MEDIA_BRIDGE_CONTROL_IMAGE=media-bridge-control:0.1.0
MEDIA_BRIDGE_DATA_IMAGE=media-bridge-data:0.1.0
MEDIA_BRIDGE_CONTROL_ORIGIN=https://localhost
MEDIA_BRIDGE_CONTROL_HOST=localhost
MEDIA_BRIDGE_SNAPSHOT_KEY_ID=media-bridge-0-1
MEDIA_BRIDGE_OCR_ENDPOINT=https://api.upstage.ai/v1/document-digitization
MEDIA_BRIDGE_VISION_ENDPOINT=https://api.openai.com/v1/chat/completions
MEDIA_BRIDGE_VISION_MODEL=gpt-4.1-mini
MEDIA_BRIDGE_DOWNSTREAM_RESPONSES_URL=http://host.docker.internal:9000/v1/responses
MEDIA_BRIDGE_DB_PASSWORD_FILE=./secrets/db-password.secret
MEDIA_BRIDGE_CONTROL_DATABASE_URL_FILE=./secrets/control-database-url.secret
MEDIA_BRIDGE_CONTROL_SECURITY_PEPPER_FILE=./secrets/control-security-pepper.secret
MEDIA_BRIDGE_SNAPSHOT_PRIVATE_KEY_FILE=./secrets/snapshot-private-key.pem
MEDIA_BRIDGE_SNAPSHOT_PUBLIC_KEY_FILE=./secrets/snapshot-public-key.secret
MEDIA_BRIDGE_GATEWAY_AUTH_PEPPER_FILE=./secrets/gateway-auth-pepper.secret
MEDIA_BRIDGE_RECEIPT_SECRET_FILE=./secrets/receipt-secret.secret
MEDIA_BRIDGE_OCR_API_KEY_FILE=./secrets/ocr-api-key.secret
MEDIA_BRIDGE_VISION_API_KEY_FILE=./secrets/vision-api-key.secret
MEDIA_BRIDGE_SOLAR_API_KEY_FILE=./secrets/solar-api-key.secret

